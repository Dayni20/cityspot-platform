              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"admin.public@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"ADMINISTRADOR\",\n  \"phone\": \"0991234567\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/register",
